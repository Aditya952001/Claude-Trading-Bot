# Deriv Bot - Environment Variables
# Copy this to .env and fill in your credentials. Keep .env out of git.

# REQUIRED
DERIV_API_TOKEN=YOUR_DEMO_TOKEN_HERE
DERIV_APP_ID=34DyB1Yk9MY6apfuxbUQV
DERIV_ENV=demo

# LIVE GUARD (leave commented)
# DERIV_LIVE_CONFIRMATION=I_UNDERSTAND_THE_RISKS

# -----------------------------------------------------------------------
# POSITION SIZING & TRADE AMOUNTS
# -----------------------------------------------------------------------
# Max fraction of equity risked per trade (default: 0.01 = 1%)
# MAX_RISK_PER_TRADE=0.01

# Minimum stake in USD allowed per trade (default: 1.00 USD)
# MIN_STAKE=1.00

# Maximum stake cap in USD per trade (default: 50.00 USD)
# MAX_STAKE=50.00

# Optional fixed stake amount in USD (0.0 = dynamic ATR volatility sizing)
# FIXED_STAKE=0.0

# Take-profit ratio relative to stop-loss (default: 2.0 = 2x stop-loss)
# REWARD_RISK=2.0

# -----------------------------------------------------------------------
# CIRCUIT BREAKERS: PROFIT & LOSS LIMITS
# -----------------------------------------------------------------------
# Stop trading for the day when realized loss reaches this % of start equity (default: 0.03 = 3%)
# MAX_DAILY_DRAWDOWN=0.03

# Stop trading for the day when realized profit reaches this % of start equity (default: 0.05 = 5%, 0 to disable)
# TARGET_DAILY_PROFIT=0.05

# Maximum number of simultaneous open positions (default: 3)
# MAX_OPEN_POSITIONS=3

# Maximum total trades allowed per day (default: 20)
# MAX_TRADES_PER_DAY=20

# Halt cooldown after N consecutive losses (default: 4)
# MAX_CONSECUTIVE_LOSSES=4

# -----------------------------------------------------------------------
# TELEGRAM LIVE ALERTS & AUDIT REPORTS
# -----------------------------------------------------------------------
# Optional: Set to receive trade open/close alerts and 15-min Live Engine Audit updates
# TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
# TELEGRAM_REPORT_INTERVAL_MIN=15


# -----------------------------------------------------------------------
# RISE/FALL EVIDENCE & CAPITAL PRESERVATION (see README "Measured reality")
# -----------------------------------------------------------------------
# Asset classes allowed for fixed-expiry Rise/Fall (comma separated).
# Forex/metals pay ~0.79-0.82 => ~55.5% breakeven, so they are gated per
# asset class: each class explores at $1 until it has RF_EDGE_MIN_TRADES
# closed trades, then must beat its own payout breakeven.
RF_ALLOWED_ASSETS=synthetic,forex,commodities

# Refuse new Rise/Fall entries unless the journal proves an edge
# (95% Wilson lower bound of win rate > payout breakeven).
RF_EDGE_GUARD_ENABLED=true
# Exploration window: below this many closed RF trades, entries are allowed
# at the fixed stake so an edge can actually be measured.
RF_EDGE_MIN_TRADES=40
# Per-symbol version of the same test.
RF_EDGE_SYMBOL_MIN_TRADES=20

# Scale stake with signal confidence. Off by default: confidence did not
# predict outcomes on the replay, so boosting only multiplies variance.
CONFIDENCE_STAKING=false

# Let the Gemini pre-trade opinion block orders. Off = advisory (logged only).
GEMINI_VETO_ENABLED=false

# -----------------------------------------------------------------------
# HYBRID MODE (Multiplier + Rise/Fall at the same time)
# -----------------------------------------------------------------------
# Both books scan their FULL capability sets; there is no static symbol split.
# Each strategy keeps its own risk ledger. A symbol can be held by only one
# book at a time: the book that opens first owns it until the contract closes.
HYBRID_ISOLATED_RISK=true
HYBRID_BLOCK_CROSS_SYMBOL=true

# If both books approve on the same bar and the symbol is free, this book
# takes the entry. Options: multiplier (default) or rise_fall.
HYBRID_SIGNAL_PRIORITY=multiplier

# Optional per-book allow-lists (comma separated). Empty = all capable
# symbols. Overlap is allowed; per-symbol ownership still prevents both books
# from holding the same instrument at once.
# HYBRID_MULT_SYMBOLS=BOOM1000,cryBTCUSD,JD75
# HYBRID_RF_SYMBOLS=R_10,1HZ100V,JD25
